{
  "name": "modulo-movil-oncologia",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepositorio del módulo móvil de acompañamiento para pacientes en quimioterapia.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json --noEmit && pnpm -r --stream run typecheck",
    "test:local": "vitest run",
    "test:ui": "pnpm --filter @modulo-movil-oncologia/mobile run test:ui",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "test:contracts": "pnpm --filter @quimiocare/contracts run test",
    "test:simulator": "pnpm --filter @quimiocare/simulator run test",
    "test:integration": "pnpm --filter @quimiocare/simulator run test:integration",
    "build:services": "pnpm --filter @quimiocare/contracts run build && pnpm --filter @quimiocare/simulator run build && pnpm --filter @quimiocare/gateway run build",
    "test:gateway": "pnpm --filter @quimiocare/gateway run test",
    "test:gateway:integration": "pnpm --filter @quimiocare/gateway run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.7.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "3.2.4"
  }
}
