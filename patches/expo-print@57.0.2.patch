+  private fun layoutAndWriteFile(view: WebView) {
+    document = view.createPrintDocumentAdapter("Document")
+    document.onStart()
+    document.onLayout(null, printAttributes, CancellationSignal(), object : PrintDocumentAdapterLayoutCallback() {
+      override fun onLayoutFinished(info: PrintDocumentInfo, changed: Boolean) {
+        if (fileRenderCompleted) return
+        numberOfPages = info.pageCount.takeIf { it > 0 } ?: 1 +
+          (view.contentHeight / (PIXELS_PER_MIL * printAttributes.mediaSize!!.heightMils)).toInt()
+        document.onWrite(arrayOf(PageRange.ALL_PAGES), fileDescriptor, CancellationSignal(), printDocumentWriteCallback)
+      }
+
+      override fun onLayoutFailed(error: CharSequence?) {
+        failFile(error)
+      }
+
+      override fun onLayoutCancelled() {
+        failFile("Print layout cancelled")
+      }
+    }, null)
+  }
+
+  private fun closeFileRender() {
+    runCatching { document.onFinish() }
+    runCatching { fileDescriptor?.close() }
+    webView.destroy()
+  }
+
+  private fun failFile(error: CharSequence?) {
+    if (fileRenderCompleted) return
+    fileRenderCompleted = true
+    closeFileRender()
+    outputFile.delete()
+    callbacks.onRenderError(PdfWriteException(IllegalStateException(error?.toString() ?: "Android rejected PDF output")))
+  }
+
