    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "expo-doctor": "~1.20.4",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-network",
        "expo-router",
        "expo-sharing",
        "expo-asset",
        "expo-constants",
        "expo-dev-client",
        "expo-notifications",
        "expo-splash-screen",
        "expo-task-manager"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-print"
        ]
      }
    }
  },
  "op-sqlite": {
    "sqlcipher": true
