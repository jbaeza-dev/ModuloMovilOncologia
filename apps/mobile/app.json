{
  "expo": {
    "name": "QuimioCare",
    "slug": "modulo-movil-oncologia",
    "scheme": "quimiocare",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "translucent": true
    },
    "android": {
      "package": "cl.ubiobio.quimiocare",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      "expo-dev-client",
      "./plugins/withReproducibleGradle.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0d9488",
          "sounds": []
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker"
    ]
  }
}
