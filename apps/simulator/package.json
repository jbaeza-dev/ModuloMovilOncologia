{
  "name": "@quimiocare/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "education:publish": "node dist/publish-education.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@quimiocare/contracts": "workspace:*",
    "busboy": "1.6.0",
    "jose": "6.2.13",
    "jpeg-js": "0.4.4",
    "pg": "8.16.3",
    "pngjs": "7.0.0",
    "swagger-ui-dist": "5.34.1"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/pg": "8.15.5",
    "@types/pngjs": "6.0.5"
  },
  "files": [
    "dist",
    "assets",
    "scripts/verify-education.mjs"
  ]
}
