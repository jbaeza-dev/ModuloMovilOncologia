FROM docker.io/library/node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS build
WORKDIR /workspace
RUN npm install --global pnpm@11.19.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/contracts/ ./packages/contracts/
COPY apps/gateway/ ./apps/gateway/
RUN sed -i 's/nodeLinker: hoisted/nodeLinker: isolated/' pnpm-workspace.yaml
COPY patches ./patches
RUN pnpm install --frozen-lockfile --ignore-scripts --filter @quimiocare/gateway...
RUN pnpm --filter @quimiocare/contracts run build && pnpm --filter @quimiocare/gateway run build

FROM docker.io/library/node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS production
WORKDIR /workspace
RUN npm install --global pnpm@11.19.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/gateway/package.json ./apps/gateway/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
RUN sed -i "s/nodeLinker: hoisted/nodeLinker: isolated/" pnpm-workspace.yaml
COPY patches ./patches
RUN pnpm install --prod --frozen-lockfile --ignore-scripts --filter @quimiocare/gateway...
COPY --from=build /workspace/apps/gateway/dist ./apps/gateway/dist
COPY --from=build /workspace/packages/contracts/dist ./packages/contracts/dist

FROM docker.io/library/node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
ENV NODE_ENV=production
# Update packages with available security patches (CVE-2026-109518 in apt/libapt-pkg6.0)
RUN apt-get update \
  && apt-get install -y --no-install-recommends apt libapt-pkg6.0 \
  && rm -rf /var/lib/apt/lists/*
# No package managers are required in the execution image.
RUN rm -rf /usr/local/lib/node_modules/npm /opt/yarn-* && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg
WORKDIR /workspace
COPY --from=production --chown=node:node /workspace /workspace
USER node
EXPOSE 3001
CMD ["node", "apps/gateway/dist/server.js"]
