# Ejemplo público sin valores secretos. No contiene datos de acceso válidos.
APP_ENV=demo
GATEWAY_PORT=3001
GATEWAY_DATABASE_URL=postgresql://qc_gateway:REEMPLAZAR@127.0.0.1:55432/qc_gateway_demo
CLINICAL_API_URL=http://127.0.0.1:3002
AI_API_URL=http://127.0.0.1:3003
AUTH_EXPECTED_ISSUER=quimiocare-demo
AUTH_EXPECTED_AUDIENCE=authenticated
AUTH_ALLOWED_ALGORITHM=HS256
AUTH_VERIFY_KEY=REEMPLAZAR_POR_CLAVE_PRIVADA_DEL_EMISOR_DEMO
PUSH_PROVIDER=expo
DEPENDENCY_TIMEOUT_MS=5000
AI_TIMEOUT_MS=60000
HTTP_REQUEST_TIMEOUT_MS=65000
SHUTDOWN_TIMEOUT_MS=10000
AGENDA_TIMEZONE=America/Santiago
AGENDA_MAX_REMINDERS=100
# Solicitudes por minuto y cuenta (general y para el asistente, G-06). Responde 429 + Retry-After.
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_RATE_LIMIT_AI_PER_MINUTE=10

# Vacío = sin acceso entre orígenes de navegador; Android nativo no necesita CORS.
CORS_ALLOWED_ORIGINS=
