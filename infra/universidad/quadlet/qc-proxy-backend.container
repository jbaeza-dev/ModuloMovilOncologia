[Unit]
Description=Nginx Proxy Reverso para Gateway Móvil y PowerSync (Puerto 8019)
After=qc-gateway.service qc-powersync.service
Requires=qc-gateway.service qc-powersync.service

[Container]
Image=docker.io/library/nginx:1.30.6-trixie@sha256:66b50d24288dba67f3d000b31223daefc4868c58d29aaacb6a4ff9771597b5eb
ContainerName=qc-proxy-backend
Network=qc.network
PublishPort=127.0.0.1:8019:8019
Volume=%h/quimiocare/current/infra/universidad/proxy/gateway.conf:/etc/nginx/conf.d/default.conf:ro,Z
HealthCmd=curl -f http://localhost:8019/healthz || exit 1
HealthInterval=15s
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
TimeoutStartSec=30
CPUQuota=100%
MemoryMax=64M

[Install]
WantedBy=default.target
