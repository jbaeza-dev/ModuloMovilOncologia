[Unit]
Description=Nginx Proxy Reverso para Simulador Clínico y Panel de Operador (Puerto 8018)
After=qc-clinical.service qc-ai.service
Requires=qc-clinical.service qc-ai.service

[Container]
Image=docker.io/library/nginx:1.30.6-trixie@sha256:66b50d24288dba67f3d000b31223daefc4868c58d29aaacb6a4ff9771597b5eb
ContainerName=qc-proxy-simulator
Network=qc.network
PublishPort=127.0.0.1:8018:8018
Volume=%h/quimiocare/current/infra/universidad/proxy/simulator.conf:/etc/nginx/conf.d/default.conf:ro,Z
HealthCmd=curl -f http://localhost:8018/healthz || exit 1
HealthInterval=15s
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
TimeoutStartSec=30
CPUQuota=100%
MemoryMax=64M

[Install]
WantedBy=default.target
