# Copiar a .local_storage/evaluation.env y sustituir TODOS los placeholders.
# Local Windows/Docker Desktop; no usar estas direcciones entre contenedores universitarios.
APP_ENV=universidad-demo
SIMULATOR_HOST=127.0.0.1
SIMULATOR_PORT=3102
GATEWAY_PORT=3101
DATABASE_URL=postgresql://USUARIO:SECRETO@127.0.0.1:5432/BASE_CLINICA_SINTETICA
GATEWAY_DATABASE_URL=postgresql://USUARIO:SECRETO@127.0.0.1:5432/BASE_GATEWAY_SINTETICA
CLINICAL_API_URL=http://127.0.0.1:3102
AI_API_URL=http://127.0.0.1:3103
AI_SERVICE_URL=http://127.0.0.1:3103
SIMULATOR_PUBLIC_BASE_URL=http://127.0.0.1:18018/quimiocare
GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:18019/quimiocare-backend
AUTH_PROVIDER=supabase
AUTH_EXPECTED_ISSUER=https://PROJECT_ID.supabase.co/auth/v1
AUTH_JWKS_URL=https://PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json
AUTH_EXPECTED_AUDIENCE=authenticated
AUTH_ALLOWED_ALGORITHM=ES256
AUTH_PUBLIC_KEY=sb_publishable_REEMPLAZAR_CLAVE_PUBLICA
DEMO_CONTROL_KEY=REEMPLAZAR_CLAVE_CONTROL_LOCAL_MINIMO_32
GATEWAY_CURSOR_KEY=REEMPLAZAR_CLAVE_CURSOR_LOCAL_MINIMO_32
PUSH_PROVIDER=expo
API_DOCS_ENABLED=false
PREPARATION_ENABLED=false
EDUCATION_MEDIA_ROOT=.local_storage/media/educacion
EDUCATION_TEMP_DIR=.local_storage/media/temp
